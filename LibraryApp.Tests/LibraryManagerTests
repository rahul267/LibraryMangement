[Fact]
public void GetAllBooks_ReturnsEmptyList_WhenNoBooksAdded()
{
    var books = _libraryManager.GetAllBooks();
    Assert.Empty(books);
}

[Fact]
public void GetAllBooks_ReturnsListOfBooks_WhenBooksAdded()
{
    var book1 = new Book("Book 1", "Author 1");
    var book2 = new Book("Book 2", "Author 2");
    _libraryManager.AddBook(book1);
    _libraryManager.AddBook(book2);
    var books = _libraryManager.GetAllBooks();
    Assert.Contains(book1, books);
    Assert.Contains(book2, books);
}

